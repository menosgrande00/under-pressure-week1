
<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.8">

  <world name="up_test_world">

    <!-- Simülasyonun fiziksel zaman adımı -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo'nun fizik, komut ve görüntüleme sistemleri -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Kameranın görüntü üretmesini sağlayan sistem -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- Sahnenin aydınlatılması -->
    <light type="directional" name="sun">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.1 -1</direction>
    </light>

    <!-- 10x10 metre zemin, kalınlık 0.1 metre -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>

      <link name="ground_link">
        <visual name="ground_visual">
          <geometry>
            <box><size>10 10 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

        <collision name="ground_collision">
          <geometry>
            <box><size>10 10 0.1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Birinci engel: mavi kutu -->
    <model name="blue_box">
      <static>true</static>
      <pose>-1.8 0 0.5 0 0 0</pose>

      <link name="box_link">
        <visual name="box_visual">
          <geometry>
            <box><size>1 1 1</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>

        <collision name="box_collision">
          <geometry>
            <box><size>1 1 1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- İkinci engel: yeşil silindir -->
    <model name="green_cylinder">
      <static>true</static>
      <pose>1.8 0 0.75 0 0 0</pose>

      <link name="cylinder_link">
        <visual name="cylinder_visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0.8 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>

        <collision name="cylinder_collision">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Üçüncü engel: sarı duvar -->
    <model name="yellow_wall">
      <static>true</static>
      <pose>0 2 0.5 0 0 0</pose>

      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box><size>3 0.3 1</size></box>
          </geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>

        <collision name="wall_collision">
          <geometry>
            <box><size>3 0.3 1</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Diğer nesnelerden ayrılan kırmızı hedef -->
    <model name="red_target">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>

      <link name="target_link">
        <visual name="target_visual">
          <geometry>
            <sphere><radius>0.5</radius></sphere>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>

        <collision name="target_collision">
          <geometry>
            <sphere><radius>0.5</radius></sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Bir araca bağlı olmayan sabit RGB kamera -->
    <model name="fixed_camera">
      <static>true</static>
      <pose>0 -4 2.2 0 0.28 1.5708</pose>

      <link name="camera_link">
        <sensor name="rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/camera/image_raw</topic>

          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>

            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
